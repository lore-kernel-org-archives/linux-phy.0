Finalize the split by separating the USB QMP PHY driver code from the
main (library) file. Now the main driver contains just a small amount of
generic code with all the corner cases and most of conditions being
stuffed into the individual drivers.

Signed-off-by: Dmitry Baryshkov <dmitry.baryshkov@linaro.org>
---
 drivers/phy/qualcomm/Makefile             |    2 +-
 drivers/phy/qualcomm/phy-qcom-qmp-combo.c |    4 +-
 drivers/phy/qualcomm/phy-qcom-qmp-lib.h   |    4 +-
 drivers/phy/qualcomm/phy-qcom-qmp-usb.c   | 2104 +++++++++++++++++++++
 drivers/phy/qualcomm/phy-qcom-qmp.c       | 2088 +-------------------
 5 files changed, 2110 insertions(+), 2092 deletions(-)
 create mode 100644 drivers/phy/qualcomm/phy-qcom-qmp-usb.c

diff --git a/drivers/phy/qualcomm/Makefile b/drivers/phy/qualcomm/Makefile
index ebc48c1c35ac..95918f1f45bb 100644
--- a/drivers/phy/qualcomm/Makefile
+++ b/drivers/phy/qualcomm/Makefile
@@ -5,7 +5,7 @@ obj-$(CONFIG_PHY_QCOM_EDP)		+= phy-qcom-edp.o
 obj-$(CONFIG_PHY_QCOM_IPQ4019_USB)	+= phy-qcom-ipq4019-usb.o
 obj-$(CONFIG_PHY_QCOM_IPQ806X_SATA)	+= phy-qcom-ipq806x-sata.o
 obj-$(CONFIG_PHY_QCOM_PCIE2)		+= phy-qcom-pcie2.o
-obj-$(CONFIG_PHY_QCOM_QMP)		+= phy-qcom-qmp.o phy-qcom-qmp-combo.o phy-qcom-qmp-pcie.o phy-qcom-qmp-ufs.o
+obj-$(CONFIG_PHY_QCOM_QMP)		+= phy-qcom-qmp.o phy-qcom-qmp-combo.o phy-qcom-qmp-pcie.o phy-qcom-qmp-ufs.o phy-qcom-qmp-usb.o
 obj-$(CONFIG_PHY_QCOM_QUSB2)		+= phy-qcom-qusb2.o
 obj-$(CONFIG_PHY_QCOM_USB_HS) 		+= phy-qcom-usb-hs.o
 obj-$(CONFIG_PHY_QCOM_USB_HSIC) 	+= phy-qcom-usb-hsic.o
diff --git a/drivers/phy/qualcomm/phy-qcom-qmp-combo.c b/drivers/phy/qualcomm/phy-qcom-qmp-combo.c
index 9ba2fd4daa51..3963215c6d6c 100644
--- a/drivers/phy/qualcomm/phy-qcom-qmp-combo.c
+++ b/drivers/phy/qualcomm/phy-qcom-qmp-combo.c
@@ -1297,7 +1297,7 @@ static int qcom_qmp_combo_phy_probe(struct platform_device *pdev)
 		} else if (of_node_name_eq(child, "usb3-phy")) {
 			/* Create per-lane phy */
 			ret = qcom_qmp_phy_create(dev, child, id, usb_serdes, usb_cfg,
-						  &qcom_qmp_phy_gen_ops);
+						  &qcom_qmp_phy_usb_ops);
 			if (ret) {
 				dev_err(dev, "failed to create lane%d phy, %d\n",
 					id, ret);
@@ -1350,7 +1350,7 @@ static struct platform_driver qcom_qmp_combo_phy_driver = {
 	.probe		= qcom_qmp_combo_phy_probe,
 	.driver = {
 		.name	= "qcom-qmp-combo-phy",
-		.pm	= &qcom_qmp_phy_pm_ops,
+		.pm	= &qcom_qmp_phy_usb_pm_ops,
 		.of_match_table = qcom_qmp_combo_phy_of_match_table,
 	},
 };
diff --git a/drivers/phy/qualcomm/phy-qcom-qmp-lib.h b/drivers/phy/qualcomm/phy-qcom-qmp-lib.h
index 14b2ec8f943f..2ee202ecf95f 100644
--- a/drivers/phy/qualcomm/phy-qcom-qmp-lib.h
+++ b/drivers/phy/qualcomm/phy-qcom-qmp-lib.h
@@ -214,9 +214,9 @@ extern const struct qmp_phy_cfg sc7180_usb3phy_cfg;
 extern const struct qmp_phy_cfg sm8150_usb3phy_cfg;
 extern const struct qmp_phy_cfg sm8250_usb3phy_cfg;
 
-extern const struct phy_ops qcom_qmp_phy_gen_ops;
+extern const struct phy_ops qcom_qmp_phy_usb_ops;
 
-extern const struct dev_pm_ops qcom_qmp_phy_pm_ops;
+extern const struct dev_pm_ops qcom_qmp_phy_usb_pm_ops;
 
 int qcom_qmp_phy_common_init(struct platform_device *pdev, const struct qmp_phy_cfg *cfg,
 			     int expected_phys);
